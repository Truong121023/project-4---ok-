# ==============================================================
# Flutter app environment
# Copy to flutter/.env and adjust values.
# DO NOT commit the real .env file.
# ==============================================================

# Backend host the mobile app reaches.
# Use the LAN IP of the machine running the backend (NOT localhost),
# because the phone/emulator is a separate device.
VITE_API_BASE_URL=http://192.168.1.100:8080
VITE_ASSET_BASE_URL=http://192.168.1.100:8080

# Google Sign-In OAuth client ID
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
