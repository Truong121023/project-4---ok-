# ==============================================================
# Root .env — used by docker-compose.yml
# Copy to .env and adjust values for your machine.
# DO NOT commit the real .env file.
# ==============================================================

# ----- MySQL -----
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=matcha_tea
MYSQL_USER=matcha_user
MYSQL_PASSWORD=12345678
MYSQL_PORT=3306

# ----- Backend (Spring Boot) -----
BACKEND_PORT=8080

# ----- Frontend (React) -----
FRONTEND_PORT=80
# Public URLs the browser uses to reach the backend.
# On the same machine: http://localhost:8080
# On LAN: http://<host-lan-ip>:8080
VITE_API_BASE_URL=http://localhost:8080
VITE_ASSET_BASE_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
